{
  "name": "wild-magic-surge-5e",
  "description": "FoundryVTT module for automated Wild Magic Surge Feat",
  "version": "1.0.0",
  "repository": "git@github.com:johnnolan/foundryvtt-wild-magic.git",
  "author": "John Nolan <me@johnnolan.dev>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ./build.js",
    "build:dev": "node ./build.js && node ./build-copy.js",
    "typecheck": "node ./scripts/typecheck.js",
    "typecheck:test": "node ./scripts/typecheck.js test",
    "test": "jest --maxWorkers=1",
    "test:coverage": "jest --ci --runInBand",
    "test:watch": "jest --watch --maxWorkers=1",
    "test:watchcov": "jest --watch --coverage --maxWorkers=1",
    "lint:check": "eslint .",
    "lint:report": "eslint --output-file eslint_report.json --format json .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/plugin-transform-modules-commonjs": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@jest/types": "30.5.1",
    "@league-of-foundry-developers/foundry-vtt-types": "14.366.0-beta.20261001000223",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.8",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@typhonjs-fvtt/eslint-config-foundry.js": "0.8.0",
    "babel-jest": "30.5.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "handlebars": "4.7.9",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "jquery": "4.0.0",
    "jshint": "2.13.6",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "jest-junit": {
    "outputDirectory": "./test-results/junit",
    "outputName": "results.xml"
  }
}
